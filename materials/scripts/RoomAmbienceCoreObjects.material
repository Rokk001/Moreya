// Materials of the sprites of the heart, portal, bridges, doors and traps (see particles/RoomAmbienceCoreObjects.particle).

material RoomAmbSwirl
{
    technique
    {
        pass
        {
            lighting off
            scene_blend add
            depth_write off
            diffuse vertexcolour

            // The sprite fades out round inside its square (tools/gen_room_ambience_art.py); clamping keeps the
            // filter from pulling colour from the opposite edge, so no edge of the turning square ever shows.
            texture_unit
            {
                texture RoomAmbSwirl.png
                tex_address_mode clamp
            }
        }
    }
}
