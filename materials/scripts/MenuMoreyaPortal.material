// The green fire that fills the portal into Moreya behind the campaign table of the start screen
// (models/MenuMoreyaPortal.mesh, tools/blender-assets/menu_moreya_entrance.py). The texture is painted by
// tools/gen_menu_portal_fire.py and tiles vertically: two layers of it rise at different speeds and add up, so the
// flames keep changing shape; the still shade texture then darkens them towards the crown and the stone at the sides.
// The fire is its own light source and ignores the scene lights.
material MenuMoreyaPortalFire
{
    technique
    {
        pass
        {
            lighting off
            texture_unit
            {
                texture MenuMoreyaPortalFire.png gamma
                tex_address_mode wrap
                scroll_anim 0 0.16
            }
            texture_unit
            {
                texture MenuMoreyaPortalFire.png gamma
                tex_address_mode wrap
                scale 1 0.7
                scroll_anim 0.02 0.29
                colour_op_ex add_smooth src_texture src_current
            }
            texture_unit
            {
                texture MenuMoreyaPortalFireShade.png
                tex_address_mode clamp
                colour_op modulate
            }
        }
    }
}
