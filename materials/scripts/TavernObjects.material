// Original textured wood, metal, stone and figure surfaces for the tavern room.

// Worn grey-brown oak, tileable, grain along v: stool and mug (INGAME-QS-11 K8, readable in the tavern light).
material TavernWood
{
    receive_shadows on
    technique
    {
        pass
        {
            ambient 0.8 0.8 0.8 1
            diffuse 1 1 1 1
            specular 0.05 0.05 0.05 1 12.5
            texture_unit
            {
                texture TavernWood.png
                tex_address_mode wrap
                filtering trilinear
            }
            // Tangent-space relief from the height of the same painting.
            texture_unit
            {
                texture TavernWoodNormal.png
                filtering trilinear
                rtshader_system
                {
                    normal_map tangent_space
                }
            }
        }
    }
}

// Worn oak of the table, its benches and its pedestal kegs, baked onto the table UV layout: grain along each board and stave,
