// The counter's own plank atlas: four worn oak plank variants side by side (bright enough for the dimly lit vertical
// front, decision 710), each counter plank is mapped onto one of
// them (no wave stripes from the shared TavernWood tiling).
material TavernCounterWood
{
    receive_shadows on
    technique
    {
        pass
        {
            ambient 0.8 0.8 0.8 1
            diffuse 1 1 1 1
            specular 0.08 0.07 0.06 1 16
            texture_unit
            {
                texture TavernCounterWoodApprovedColor.png
                tex_address_mode wrap
                filtering trilinear
            }
            // Tangent-space detail baked from the approved Blender surface.
            texture_unit
            {
                texture TavernCounterWoodApprovedNormal.png
                filtering trilinear
                rtshader_system
                {
                    normal_map tangent_space
                }
            }
        }
    }
}

// Aged brass of the counter's foot rail, sign rim and hand bell; a faint self-light keeps it readable from the room
// camera in the dark tavern without glaring yellow (decision 710: the stronger glow read as a yellow edge).
material TavernRail
{
    receive_shadows on
    technique
    {
        pass
        {
            ambient 0.8 0.8 0.8 1
            diffuse 1 1 1 1
            specular 0.6 0.5 0.32 1 32
            emissive 0.08 0.06 0.025 1
            texture_unit
            {
                texture TavernRailApprovedColor.png
                tex_address_mode wrap
                filtering trilinear
            }
            // Tangent-space detail baked from the approved Blender surface.
            texture_unit
            {
                texture TavernRailApprovedNormal.png
                filtering trilinear
                rtshader_system
                {
                    normal_map tangent_space
                }
            }
        }
    }
}

material TavernVomit
{
    receive_shadows on
    technique
    {
        pass
        {
            ambient 0.8 0.8 0.8 1
            diffuse 1 1 1 1
            specular 0.05 0.05 0.05 1 12.5
            scene_blend alpha_blend
            depth_write off
            cull_hardware none
            depth_bias 1
            texture_unit
            {
                texture TavernVomit.png
                tex_address_mode wrap
                filtering trilinear
            }
        }
    }
}
