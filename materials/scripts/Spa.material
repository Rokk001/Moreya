}

// The red and the off-white bands of the lifebuoy at the attendant's chair (decision 837, variant 1 of the design:
// a worn red and white life ring); muted bands for the dark room (A3 owner findings 2026-11-17); the painted
// canvas texture (cracks, chips, grime) is tinted by each band's colour (K22)
material SpaLifebuoyRed : RTSS/PerPixel_SinglePass
{
    technique
    {
        pass
        {
            ambient 1 1 1 1
            diffuse 0.58 0.14 0.1 1
            emissive 0.04 0.006 0.004
            specular 0.12 0.1 0.1 1 16
            texture_unit
            {
                texture SpaLifebuoy.png
            }
        }
    }
}

material SpaLifebuoyWhite : RTSS/PerPixel_SinglePass
