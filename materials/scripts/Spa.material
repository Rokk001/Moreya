// Face and scalp skin of the pool attendant: baked shading (folds, eye sockets, ruddy nose, cheeks and ears, stubble on
// the jaw, frown lines) in its own texture (A3 owner findings 2026-11-17)
material SpaAttendantFace : RTSS/PerPixel_SinglePass
{
    technique
    {
        pass
        {
            diffuse 1 1 1 1
            specular 0.06 0.05 0.05 1 12
            texture_unit
            {
                texture SpaAttendantFace.png
                tex_address_mode wrap clamp
            }
        }
    }
}

