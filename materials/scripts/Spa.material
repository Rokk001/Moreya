// Original hot mud bath objects.
import RTSS/PerPixel_SinglePass from "RTShaderSystem.material"

material SpaMud : RTSS/PerPixel_SinglePass
{
    technique
    {
        // Decision 837: hot liquid mud instead of a near-black slab (the dark ground texture of dug-out tiles times 0.4 0.25
        // 0.13 was almost black). Own painted mud (tools/spa-textures/generate_spa_mud.py), a wet gloss and a faint warmth
        // of the lava below; it stays opaque, because the mud hides the lower body of the bathers (spa plan D6, 5.3).
        // Flush surface patches share height, up normals and a full repeating UV period. There are no bevelled box
        // edges or UV atlas islands at internal tile boundaries, so the bath reads as one continuous liquid surface.
        pass
        {
            ambient 1 1 1 1
            diffuse 1 1 1 1
            specular 0.5 0.42 0.32 1 36
            emissive 0.14 0.06 0.02
            texture_unit
            {
                texture SpaMud.png
                tex_address_mode wrap
                scroll_anim 0.02 0.01
            }
        }
    }
}

// Expanding glossy domes pop above the opaque mud; only their soft sprite edges blend.
material SpaMudBubble
{
    technique
    {
        pass
        {
            lighting off
            scene_blend alpha_blend
            depth_write off
            cull_hardware none
            texture_unit
            {
                texture SpaMudBubble.png
                tex_address_mode clamp
            }
        }
    }
}

