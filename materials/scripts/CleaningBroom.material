// Twig broom a worker holds while it cleans (INGAME-QS-10 K26): dark weathered handle, cord binding and a dull,
// dirty twig bundle in one texture. No specular: wood and twigs do not shine.
import RTSS/PerPixel_SinglePass from "RTShaderSystem.material"
material CleaningBroom : RTSS/PerPixel_SinglePass
{
    technique
    {
        pass
        {
            ambient 1.0 1.0 1.0 1.0
            diffuse 1.0 1.0 1.0 1.0
            specular 0.0 0.0 0.0 1.0 1.0
            emissive 0.0 0.0 0.0 0.0

            texture_unit
            {
                texture CleaningBroom.png
            }
        }
    }
}

// The loose twigs are single cards: both sides are drawn
material CleaningBroom/Twigs : RTSS/PerPixel_SinglePass
{
    technique
    {
        pass
        {
            ambient 1.0 1.0 1.0 1.0
            diffuse 1.0 1.0 1.0 1.0
            specular 0.0 0.0 0.0 1.0 1.0
            emissive 0.0 0.0 0.0 0.0
            cull_hardware none

            texture_unit
            {
                texture CleaningBroom.png
            }
        }
    }
}
