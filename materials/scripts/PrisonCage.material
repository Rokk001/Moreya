// Prison cage: dark forged iron of the bars, straps, posts and door (FenceStraight, FenceCorner, PrisonDoor).
// Dull and dark (style guide: dark iron, rust only as small flecks, no bright steel); a faint sheen only.
material PrisonIron
{
    receive_shadows on
    technique
    {
        pass
        {
            ambient 0.75 0.75 0.75
            diffuse 0.9 0.9 0.9 1
            specular 0.1 0.09 0.08 1 12
            texture_unit
            {
                texture PrisonIron.png
                tex_address_mode wrap
                filtering trilinear
            }
        }
    }
}
