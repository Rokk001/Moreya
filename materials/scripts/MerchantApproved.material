// Approved merchant Robe surface, baked from the editable Blender material.
material MerchantApprovedRobe
{
    receive_shadows on
    technique
    {
        pass
        {
            ambient 0.8 0.8 0.8 1
            diffuse 1 1 1 1
            specular 0.06 0.06 0.06 1 12
            emissive 0 0 0
            texture_unit
            {
                texture MerchantRobeApprovedColor.png
                tex_address_mode clamp
                filtering trilinear
            }
            texture_unit
            {
                texture MerchantRobeApprovedNormal.png
                tex_address_mode clamp
                filtering trilinear
                rtshader_system
                {
                    normal_map tangent_space
                }
            }
        }
    }
}
