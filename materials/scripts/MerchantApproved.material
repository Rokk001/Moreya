// Opaque hand variant of MerchantApprovedHide for the skin of the hands (INGAME-QS-10 K20): the same colour
// atlas without the tangent-space normal map, which GPU skinning does not turn with the hand, so a turned hand
// was lit as if seen through.
material MerchantApprovedHideHand
{
    receive_shadows on
    technique
    {
        pass
        {
            ambient 0.8 0.8 0.8 1
            diffuse 1 1 1 1
            specular 0.12 0.10 0.09 1 18
            emissive 0 0 0
            texture_unit
            {
                texture MerchantHideApprovedColor.png
                tex_address_mode clamp
                filtering trilinear
            }
        }
    }
}
// Opaque hand variant of MerchantApprovedDetails for the nails of the hands (INGAME-QS-10 K20): the same colour
