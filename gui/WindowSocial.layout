<GUILayout version="4">
    <Window type="OD/SheetWindow" name="SocialWindow">
        <!-- The pages keep the layout of the concepts (book-variant-2.png, book-switch-variant-1.png); the window
             frame and the title are the frame of the chosen menu sheet that every window uses,
             no longer the ornate iron frame with the large title. The window is 860x648 design pixels (880x644 in the
             ornate frame): as high as the HUD leaves room for at 1024x768 and narrow enough that it is shrunk only
             to the screen height at 640x480, so every text of the pages keeps its room. -->
