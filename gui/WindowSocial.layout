        <!-- The pages cover the head, and a click on a page raises it above its siblings (CEGUI rise on click), so the head with the switch arrows and the navigation bar stay always on top of the pages (owner decision 921). The head is "< Name >" below the title (book-switch-variant-1); the back arrow sits in the title bar. -->
        <Window type="DefaultWindow" name="Header">
            <Property name="Area" value="{{0.012,0},{0,0},{0.988,0},{0.075,0}}" />
            <Property name="Visible" value="False" />
            <Property name="AlwaysOnTop" value="True" />
            <Window type="OD/Button" name="PrevButton">
                <Property name="Area" value="{{0.2132,0},{0.0722,0},{0.2589,0},{0.9278,0}}" />
                <Property name="Text" value="" />
