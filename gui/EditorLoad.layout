<?xml version="1.0" encoding="UTF-8"?>

<GUILayout version="4" >
    <Window type="DefaultWindow" name="MenuEditorLoad" >
        <Property name="Area" value="{{0,0},{0,0},{1,0},{1,0}}" />
        <Property name="MaxSize" value="{{1,0},{1,0}}" />
        <Window type="OD/StaticText" name="VersionText" >
            <Property name="Area" value="{{0.5,200},{0,171},{0.5,300},{0,191}}" />
            <Property name="Text" value="undefined" />
            <Property name="MaxSize" value="{{1,0},{1,0}}" />
            <Property name="FrameEnabled" value="False" />
            <Property name="BackgroundEnabled" value="False" />
        </Window>
<!--#@own 1-->
            <Property name="Text" value="@layout.editor_load.menu_editor_load.level_window_frame.text" />
            <Property name="MaxSize" value="{{0,800},{0,600}}" />
            <Property name="MinSize" value="{{0,400},{0,300}}" />
            <Property name="AlwaysOnTop" value="True" />

            <Window type="OD/Editbox" name="FilePath" >
                <Property name="Area" value="{{0,20},{0,35},{1.0,-25},{0,70}}" />
            </Window>
            
<!--#@own 2-->
                <Property name="Area" value="{{0,15},{0,65},{0.5,-20},{0.7,0}}" />
                <Property name="ForceVertScrollbar" value="True" />
