<?xml version="1.0" encoding="UTF-8"?>

<!-- Skill tree of one creature, opened from its Dungeonbook profile and filled by SocialWindow:
     the tier 4 skill on top, then one column per path (three group paths, the family path) with
     tier 3, 2 and 1 from top to bottom. Each skill is an icon button with a rank bar and a rank text. -->
<GUILayout version="4" >
    <Window type="OD/SheetWindow" name="CreatureSkillTreeWindow" >
        <Property name="Area" value="{{0.5,-300},{0.5,-290},{0.5,300},{0.5,290}}" />
        <Property name="Text" value="Skill Tree" />
        <Property name="SizingEnabled" value="False" />
        <Property name="AlwaysOnTop" value="True" />
        <Property name="Visible" value="False" />
        <Window type="OD/StaticImage" name="Tree" >
            <Property name="Area" value="{{0,16},{0,8},{1,-16},{1,-16}}" />
            <Property name="MaxSize" value="{{1,0},{1,0}}" />
            <Window type="OD/ResearchButton" name="TierFour" >
                <Property name="Area" value="{{0.5,-32},{0,10},{0.5,32},{0,74}}" />
                <Property name="ButtonImage" value="CreatureSkillIcons/BLK_A1" />
                <Property name="TooltipText" value="" />
            </Window>
            <Window type="OD/ProgressBar" name="TierFourBar" >
                <Property name="Area" value="{{0.5,-32},{0,78},{0.5,32},{0,86}}" />
                <Property name="CurrentProgress" value="0.0" />
                <Property name="MousePassThroughEnabled" value="True" />
                <Property name="ProgressImage" value="OpenDungeonsSkin/ProgressBarLitSegment" />
            </Window>
            <Window type="OD/StaticText" name="TierFourRank" >
                <Property name="Area" value="{{0.5,-40},{0,88},{0.5,40},{0,106}}" />
                <Property name="Text" value="0/5" />
                <Property name="FrameEnabled" value="False" />
                <Property name="BackgroundEnabled" value="False" />
                <Property name="Font" value="MedievalSharp-8" />
                <Property name="HorzFormatting" value="CentreAligned" />
                <Property name="MousePassThroughEnabled" value="True" />
            </Window>
            <Window type="OD/StaticText" name="Column0Title" >
                <Property name="Area" value="{{0.125,-64},{0,112},{0.125,64},{0,132}}" />
