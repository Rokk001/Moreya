                    </OperatorDim>
                </Dim>
            </Area>
        </NamedArea>
        <Child nameSuffix="__auto_listheader__" type="OD/ListHeader">
            <Area>
                <Dim type="LeftEdge"><AbsoluteDim value="2" /></Dim>
                <Dim type="TopEdge"><AbsoluteDim value="2" /></Dim>
                <Dim type="RightEdge"><UnifiedDim offset="-2" scale="1" type="RightEdge" /></Dim>
                <Dim type="Height">
                    <OperatorDim op="Multiply">
                        <FontDim type="LineSpacing" />
                        <AbsoluteDim value="1.5" />
                    </OperatorDim>
                </Dim>
            </Area>
        </Child>
        <Child nameSuffix="__auto_hscrollbar__" type="OD/HorizontalScrollbar">
            <Area>
