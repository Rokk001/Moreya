                        <ImageDim dimension="Height" name="OpenDungeonsSkin/MultiListBottom" />
                    </OperatorDim>
                </Dim>
            </Area>
        </NamedArea>
        <NamedArea name="ItemRenderingAreaHVScroll">
            <Area>
                <Dim type="LeftEdge"><ImageDim dimension="Width" name="OpenDungeonsSkin/MultiListLeft" /></Dim>
