    <WidgetLook name="OD/ListHeaderSegment">
        <Property name="SizingCursorImage" value="OpenDungeonsSkin/MouseEsWeCursor" />
        <Property name="MovingCursorImage" value="OpenDungeonsSkin/MouseMoveCursor" />
        <ImagerySection name="segment_normal">
            <Colours bottomLeft="FFDDDDDD" bottomRight="FFDDDDDD" topLeft="FFDDDDDD" topRight="FFDDDDDD" />
            <ImageryComponent>
                <Area>
                    <Dim type="LeftEdge"><AbsoluteDim value="0" /></Dim>
