                <Image component="LeftEdge" name="OpenDungeonsSkin/MultiListLeft" />
                <Image component="RightEdge" name="OpenDungeonsSkin/MultiListRight" />
                <Image component="TopEdge" name="OpenDungeonsSkin/MultiListTop" />
                <Image component="BottomEdge" name="OpenDungeonsSkin/MultiListBottom" />
                <Image component="Background" name="OpenDungeonsSkin/MultiListMiddle" />
            </FrameComponent>
        </ImagerySection>
        <StateImagery name="Enabled">
            <Layer>
                <Section section="main" />
            </Layer>
        </StateImagery>
