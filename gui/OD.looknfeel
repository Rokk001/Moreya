            </ImageryComponent>
        </ImagerySection>
        <ImagerySection name="ascend_icon">
            <ImageryComponent>
                <Area>
                    <Dim type="LeftEdge"><AbsoluteDim value="3" /></Dim>
                    <Dim type="TopEdge"><AbsoluteDim value="3" /></Dim>
                    <Dim type="Width"><ImageDim dimension="Width" name="OpenDungeonsSkin/HeaderBarSortUp" /></Dim>
                    <Dim type="Height"><ImageDim dimension="Height" name="OpenDungeonsSkin/HeaderBarSortUp" /></Dim>
                </Area>
                <Image name="OpenDungeonsSkin/HeaderBarSortUp" />
            </ImageryComponent>
        </ImagerySection>
        <ImagerySection name="descend_icon">
            <ImageryComponent>
                <Area>
                    <Dim type="LeftEdge"><AbsoluteDim value="3" /></Dim>
                    <Dim type="TopEdge"><AbsoluteDim value="3" /></Dim>
                    <Dim type="Width"><ImageDim dimension="Width" name="OpenDungeonsSkin/HeaderBarSortDown" /></Dim>
                    <Dim type="Height"><ImageDim dimension="Height" name="OpenDungeonsSkin/HeaderBarSortDown" /></Dim>
                </Area>
                <Image name="OpenDungeonsSkin/HeaderBarSortDown" />
            </ImageryComponent>
        </ImagerySection>
        <ImagerySection name="label">
            <TextComponent>
                <Area>
                    <Dim type="LeftEdge">
                        <OperatorDim op="Add">
                            <ImageDim dimension="Width" name="OpenDungeonsSkin/HeaderBarSortUp" />
                            <AbsoluteDim value="5" />
                        </OperatorDim>
                    </Dim>
                    <Dim type="TopEdge"><AbsoluteDim value="0" /></Dim>
                    <Dim type="RightEdge"><UnifiedDim scale="1" type="RightEdge" /></Dim>
                    <Dim type="Height"><UnifiedDim scale="1" type="Height" /></Dim>
                </Area>
                <VertFormat type="CentreAligned" />
            </TextComponent>
        </ImagerySection>
        <StateImagery name="Normal">
            <Layer>
                <Section section="segment_normal" />
                <Section section="splitter_normal" />
                <Section section="label" />
            </Layer>
        </StateImagery>
        <StateImagery name="Hover">
            <Layer>
                <Section section="segment_hover" />
<!--#@own 287-->
            </Layer>
        </StateImagery>
        <StateImagery name="SplitterHover">
            <Layer>
<!--#@own 288-->
                <Section section="splitter_hover" />
<!--#@own 289-->
            </Layer>
        </StateImagery>
        <StateImagery clipped="false" name="DragGhost">
            <Layer priority="1">
                <Section section="segment_normal">
                    <Colours bottomLeft="90FFFFFF" bottomRight="90FFFFFF" topLeft="90FFFFFF" topRight="90FFFFFF" />
                </Section>
                <Section section="splitter_normal">
                    <Colours bottomLeft="90FFFFFF" bottomRight="90FFFFFF" topLeft="90FFFFFF" topRight="90FFFFFF" />
                </Section>
                <Section section="label">
                    <Colours bottomLeft="90FFFFFF" bottomRight="90FFFFFF" topLeft="90FFFFFF" topRight="90FFFFFF" />
                </Section>
            </Layer>
        </StateImagery>
        <StateImagery name="AscendingSortIcon">
