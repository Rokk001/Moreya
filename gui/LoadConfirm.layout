<?xml version="1.0" encoding="UTF-8"?>

<GUILayout version="4" >
<!--#@own 1-->
        <Property name="Alpha" value="0.8" />
        <Property name="AlwaysOnTop" value="True" />
        <Property name="Text" value="@layout.load_confirm.confirm_load.text" /> 
        <Property name="AlwaysOnTop" value="True" />
        <Window type="OD/StaticText" name="Message" >
       	    <Property name="Text" value="@layout.load_confirm.confirm_load.message.text" />
            <Property name="InheritsAlpha" value="False" />
	    <Property name="Area" value="{{0.5,-220},{0.5,-100},{0.5,220},{0.5,0}}" />
        </Window>
<!--#@own 2-->
            <Property name="Text" value="@layout.load_confirm.confirm_load.yes_option.text" />
            <Property name="TooltipText" value="@layout.load_confirm.confirm_load.yes_option.tooltip" />
            <Property name="InheritsAlpha" value="False" />
        </Window>
<!--#@own 3-->
            <Property name="Text" value="@layout.load_confirm.confirm_load.no_option.text" />
            <Property name="TooltipText" value="@layout.load_confirm.confirm_load.no_option.tooltip" />
            <Property name="InheritsAlpha" value="False" />
        </Window>
    </Window>
</GUILayout>
