<?xml version="1.0" encoding="UTF-8"?>

<GUILayout version="4" >
    <Window type="DefaultWindow" name="EDITORGUI" >
        <Property name="Area" value="{{0,-1},{0,-1},{1,-1},{1,-1}}" />
        <Property name="MaxSize" value="{{1,0},{1,0}}" />
        <Window  type="OD/Menubar" name="Menubar">
            <Property name="Area" value="{{0,0},{0,11},{1,0},{0,23}}" />

            <Window type="OD/MenuItem" name="File">
                <Property name="Text" value="@layout.mode_editor.editorgui.menubar.file.text"/>
                <Property name="Area" value="{{0,0},{0,10},{0,0},{0,20}}" />
                <Window type="OD/PopupMenu" name="PopupMenu1">
                    <Window type="OD/MenuItem" name="New">
                        <Property name="Text" value="@layout.mode_editor.editorgui.menubar.file.popup_menu1.new.text"/>     
                    </Window>
                    <Window type="OD/MenuItem" name="Load">
                        <Property name="Text" value="@layout.mode_editor.editorgui.menubar.file.popup_menu1.load.text"/>     
                    </Window>
                    <Window type="OD/MenuItem" name="Save">
                        <Property name="Text" value="@layout.mode_editor.editorgui.menubar.file.popup_menu1.save.text"/>     
                    </Window>
                    <Window type="OD/MenuItem" name="SaveAs">
                        <Property name="Text" value="@layout.mode_editor.editorgui.menubar.file.popup_menu1.save_as.text"/>     
                    </Window>
                    <Window type="OD/MenuItem" name="RecentlyUsed">
                        <Property name="Text" value="@layout.mode_editor.editorgui.menubar.file.popup_menu1.recently_used.text"/>     
                	<Window type="OD/PopupMenu" name="PopupMenu2">
                    	</Window>
                    </Window>
                    <Window type="OD/MenuItem" name="Quit">
                        <Property name="Text" value="@layout.mode_editor.editorgui.menubar.file.popup_menu1.quit.text"/>     
                    </Window>
                </Window>
            </Window>
            <Window type="OD/MenuItem" name="Edit">
                <Property name="Text" value="@layout.mode_editor.editorgui.menubar.edit.text"/>
                <Property name="Area" value="{{0,0},{0,10},{0,0},{0,20}}" />
                <Window type="OD/PopupMenu" name="PopupMenu3">
                    <Window type="OD/MenuItem" name="Copy">
                        <Property name="Text" value="@layout.mode_editor.editorgui.menubar.edit.popup_menu3.copy.text"/>     
                    </Window>
                    <Window type="OD/MenuItem" name="Paste">
                        <Property name="Text" value="@layout.mode_editor.editorgui.menubar.edit.popup_menu3.paste.text"/>     
                    </Window>
                    <Window type="OD/MenuItem" name="Delete">
                        <Property name="Text" value="@layout.mode_editor.editorgui.menubar.edit.popup_menu3.delete.text"/>     
                    </Window>
                </Window>
            </Window>
            <Window type="OD/MenuItem" name="Creatures">
                <Property name="Text" value="@layout.mode_editor.editorgui.menubar.creatures.text"/>
                <Property name="Area" value="{{0,0},{0,10},{0,0},{0,20}}" />
                <Window type="OD/PopupMenu" name="PopupMenu4">
                </Window>
            </Window>
            <Window type="OD/MenuItem" name="Seats">
                <Property name="Text" value="@layout.mode_editor.editorgui.menubar.seats.text"/>
                <Property name="Area" value="{{0,0},{0,10},{0,0},{0,20}}" />
                <Window type="OD/PopupMenu" name="PopupMenu5">
                </Window>
            </Window>
            <Window type="OD/MenuItem" name="Help">
                <Property name="Text" value="@layout.mode_editor.editorgui.menubar.help.text"/>
                <Property name="Area" value="{{0,0},{0,10},{0,0},{0,20}}" />
                <Window type="OD/PopupMenu" name="PopupMenu6">
                    <Window type="OD/MenuItem" name="Controls">
                        <Property name="Text" value="@layout.mode_editor.editorgui.menubar.help.popup_menu6.controls.text"/>     
                    </Window>
                </Window>
            </Window>

        </Window>
        <Window type="OD/StaticImage" name="HorizontalPipe" >
            <Property name="Area" value="{{0,0},{1,-143},{1,0},{1,-133}}" />
            <Property name="Image" value="OpenDungeonsSkin/HorizontalPipe" />
            <Property name="MaxSize" value="{{1,0},{1,0}}" />
            <Property name="FrameEnabled" value="False" />
            <Property name="AlwaysOnTop" value="False" />
            <Property name="HorzFormatting" value="Tiled" />
            <Property name="BackgroundEnabled" value="False" />
            <Property name="VerticalAlignment" value="Center" />
            <Window type="OD/StaticText" name="FullnessDisplay" >
                <Property name="AlwaysOnTop" value="True" />
                <Property name="Area" value="{{0,5},{0,0},{0,200},{0,25}}" />
