<?xml version="1.0" encoding="UTF-8"?>

<GUILayout version="4" >
    <Window type="DefaultWindow" name="Root" >
        <Property name="Area" value="{{0,0},{0,0},{1,0},{1,0}}" />
        <Property name="MaxSize" value="{{1,0},{1,0}}" />
        <!-- Iron border of the chosen menu sheet around the whole screen. -->
        <Window type="OD/ScreenBorder" name="ScreenBorder" >
            <Property name="Area" value="{{0,0},{0,0},{1,0},{1,0}}" />
            <Property name="MousePassThroughEnabled" value="True" />
        </Window>
        <Window type="OD/StaticImage" name="WelcomeBanner" >
            <Property name="Visible" value="False" />
            <Property name="Area" value="{{0.5,-166.5},{0,32},{0.5,166.5},{0,143}}" />
