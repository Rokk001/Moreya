<?xml version="1.0" encoding="UTF-8"?>
<GUILayout version="4">
    <!-- Define user cameras, opened from the settings navigation window; its buttons are menu template buttons like
         the entries of the in-game options menu (INGAME-QS-11 K7). -->
    <Window type="OD/SheetWindow" name="UserCamerasWindow">
        <Property name="Area" value="{{0.5,-320},{0,32},{0.5,320},{0,392}}" />
        <Property name="Text" value="Define user cameras" />
        <Property name="Visible" value="False" />
        <Property name="SizingEnabled" value="False" />
        <Window type="OD/MenuTextButton" name="Camera1">
            <Property name="Font" value="MedievalSharp-10" />
            <Property name="Area" value="{{0,16},{0,36},{0.3333,-8},{0,80}}" />
            <Property name="Text" value="Camera 1 (F4)" />
        </Window>
        <Window type="OD/MenuTextButton" name="Camera2">
            <Property name="Font" value="MedievalSharp-10" />
            <Property name="Area" value="{{0.3333,8},{0,36},{0.6667,-8},{0,80}}" />
            <Property name="Text" value="Camera 2" />
        </Window>
        <Window type="OD/MenuTextButton" name="Camera3">
            <Property name="Font" value="MedievalSharp-10" />
            <Property name="Area" value="{{0.6667,8},{0,36},{1,-16},{0,80}}" />
            <Property name="Text" value="Camera 3 (F6)" />
        </Window>
        <Window type="OD/StaticText" name="Instructions">
            <Property name="Area" value="{{0,16},{0,92},{1,-16},{0,176}}" />
            <Property name="Text" value="Hold Ctrl to adjust:&#10;Insert / Delete: roll   Page Up / Down: yaw&#10;Home / End: pitch" />
            <Property name="FrameEnabled" value="False" />
            <Property name="BackgroundEnabled" value="False" />
        </Window>
        <Window type="OD/MenuTextButton" name="Store">
            <Property name="Font" value="MedievalSharp-13" />
            <Property name="Area" value="{{0.5,-90},{0,184},{0.5,90},{0,240}}" />
            <Property name="Text" value="Store" />
        </Window>
    </Window>
</GUILayout>
